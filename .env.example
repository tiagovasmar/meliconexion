# ---- Datos de la aplicación creada en developers.mercadolibre.com.ar ----
MELI_APP_ID=TU_APP_ID
MELI_APP_SECRET=TU_SECRET_KEY

# Dominio de autorización según el país del vendedor (Argentina = .com.ar)
# Ver https://api.mercadolibre.com/sites para otros países (MLB=.com.br, MLM=.com.mx, etc)
MELI_AUTH_DOMAIN=https://auth.mercadolibre.com.ar

# ---- URL pública donde queda desplegado este servidor (sin barra final) ----
# La completás después del primer deploy en Render (o el hosting que uses)
PUBLIC_URL=https://TU-SERVICIO.onrender.com

# ---- Codex (opcional) ----
# URL de callback exacta que muestra "codex mcp add ... --oauth-client-id TU_APP_ID-codex".
# Requiere que tu aplicación de Mercado Libre tenga PKCE habilitado.
CODEX_CALLBACK_URL=

# ---- Seguridad ----
# Cadena aleatoria larga para cifrar datos en disco. Generarla con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Una vez que hiciste el primer login con tu cuenta de Mercado Libre,
# completá esto con tu seller id (te lo muestra el log del server y /health)
# para que el conector rechace cualquier otra cuenta que no sea la tuya.
ALLOWED_SELLER_ID=

PORT=3000
